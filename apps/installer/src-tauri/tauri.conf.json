{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NANOMultipleGitGUI Setup",
  "mainBinaryName": "nanomgg-setup",
  "identifier": "io.github.congluuit.nanomultiplegitgui.setup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Cong Luu",
    "copyright": "Copyright 2026 Cong Luu. Licensed under Apache-2.0.",
    "shortDescription": "NANOMultipleGitGUI Setup",
    "icon": [
      "../../desktop/src-tauri/icons/32x32.png",
      "../../desktop/src-tauri/icons/128x128.png",
      "../../desktop/src-tauri/icons/128x128@2x.png",
      "../../desktop/src-tauri/icons/icon.icns",
      "../../desktop/src-tauri/icons/icon.ico"
    ]
  }
}
